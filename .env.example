# Copy to `.env` for local development:  cp .env.example .env
# Never commit your real `.env`.

DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated. Add your domain when deploying, e.g. janezhang1201.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://janezhang1201.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: GitHub username for project import (defaults to the GitHub URL in your profile)
GITHUB_USERNAME=
# Optional: raises the GitHub API rate limit; a token with no scopes is enough
GITHUB_TOKEN=
